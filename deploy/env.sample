# Nombre de archivo: env.sample
# Ubicación de archivo: deploy/env.sample
# Descripción: Variables de entorno de ejemplo para desplegar servicios

# Base de datos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=FOCALDB
POSTGRES_USER=FOCALBOT
POSTGRES_PASSWORD=cambiar_por_password_seguro

# Bot de Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=11111111,22222222

# NLP / LLM
# Default fijado a openai. El despliegue estándar no usa Ollama local ni host.docker.internal.
LLM_PROVIDER=openai
OPENAI_API_KEY=
INTENT_THRESHOLD=0.7
LANG=es
LOG_RAW_TEXT=false
INTENT_CLARIFY_PROVIDER=heuristic
INTENT_ACTION_PROVIDER=heuristic
INTENT_DOMAIN_CLASSIFIER=heuristic
INTENT_ENABLE_ANSWERS=true
INTENT_MAX_ANSWER_CHARS=800
INTENT_ACTIONS_ENABLED=repetitividad_report

# Informes
TEMPLATES_DIR=/app/Templates
SLA_TEMPLATE_PATH=${TEMPLATES_DIR}/Template_Informe_SLA.docx
REP_TEMPLATE_PATH=${TEMPLATES_DIR}/Plantilla_Informe_Repetitividad.docx
REPORTS_DIR=/app/data/reports
UPLOADS_DIR=/app/data/uploads
SOFFICE_BIN=/usr/bin/soffice
MAPS_ENABLED=false
MAPS_LIGHTWEIGHT=true

# Web/UI
API_BASE=http://172.18.208.162:8080
WEB_SECRET_KEY=cambiar_por_clave_web_segura
LOG_LEVEL=INFO
ENV=development
REPORTS_API_BASE=http://api:8000
REPORTS_API_TIMEOUT=60
LAS_FOCAS_API_KEY=cambiar_por_api_key_segura
WEB_CHAT_ALLOWED_ORIGINS=
WEB_INFERRED_ORIGIN=http://172.18.208.162:8080
CHAT_UPLOAD_MAX_BYTES=15728640
WEB_LOGIN_RATE_LIMIT_MAX=5
WEB_LOGIN_RATE_LIMIT_WINDOW=60
WEB_SESSION_HTTPS_ONLY=false
WEB_SESSION_MAX_AGE=28800

# Infraestructura (Sheets → DB)
INFRA_SHEET_ID=
INFRA_SHEET_NAME=Camaras
# Montar Keys/credentials.json dentro del contenedor o definir GOOGLE_CREDENTIALS_JSON con el contenido del Service Account
#GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Servicio LibreOffice/UNO
OFFICE_ENABLE_UNO=true
OFFICE_LOG_LEVEL=INFO
OFFICE_SOFFICE_PORT=2002
OFFICE_SOFFICE_CONNECT_HOST=127.0.0.1
OFFICE_SERVICE_BASE=http://office_service:8003

# Notificaciones por correo (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notificaciones@example.com
SMTP_PASS=cambiar_por_password_smtp
SMTP_FROM_EMAIL=notificaciones@example.com
SMTP_FROM_NAME=LAS-FOCAS Notificaciones
SMTP_USE_TLS=true

# Notificaciones Slack (worker de baneos)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Cromo Red (ingesta de inventario FO, sólo lectura)
# Autenticación vía api-gateway: OAuth2 grant_type=password (ver manual oficial de Cromo Red).
# CROMO_CLIENT_ID/CROMO_CLIENT_SECRET son credenciales de aplicación (OAUTH_CLIENT_DETAILS),
# distintas de CROMO_USER/CROMO_PASSWORD (credenciales del usuario). CROMO_PASSWORD y
# CROMO_CLIENT_SECRET también pueden proveerse como Docker Secrets (cromo_password_v1,
# cromo_client_secret_v1); si el secreto no existe, se usa esta variable de entorno.
CROMO_BASE_URL=http://cambiar-por-host-cromo:8181
CROMO_USER=cambiar_por_usuario_cromo
CROMO_PASSWORD=cambiar_por_password_cromo
CROMO_TIMEOUT=30
CROMO_PSIZE_DEFAULT=5
# Opcional: si no se define, se deriva de CROMO_BASE_URL en el puerto 9999.
CROMO_OAUTH_URL=
# Opcional: si no se definen, se usan los valores de fábrica del manual (a confirmar con el admin de Cromo).
CROMO_CLIENT_ID=
CROMO_CLIENT_SECRET=
