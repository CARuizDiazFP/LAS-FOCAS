# Nombre de archivo: env.dev.sample
# Ubicación de archivo: deploy/env.dev.sample
# Descripción: Variables de entorno para el entorno de DESARROLLO (Dev) — copiar a .env.dev en la raíz del proyecto

# ─── BASE DE DATOS (DEV) ──────────────────────────────────────────────────────
# Apunta a la base focas_dev para aislar completamente datos de producción
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=focas_dev
POSTGRES_USER=FOCALBOT
POSTGRES_PASSWORD=cambiar_por_password_dev_seguro

# ─── Bot de Telegram ──────────────────────────────────────────────────────────
# Dejar vacío para deshabilitar el bot en dev (evita colisión con el bot de prod)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=11111111,22222222

# ─── NLP / LLM ────────────────────────────────────────────────────────────────
# heuristic por defecto en dev: no consume API externa, sin costos.
# Si se desea probar el flujo productivo, usar LLM_PROVIDER=openai y definir OPENAI_API_KEY.
LLM_PROVIDER=heuristic
OPENAI_API_KEY=
INTENT_THRESHOLD=0.7
LANG=es
LOG_RAW_TEXT=false
INTENT_CLARIFY_PROVIDER=heuristic
INTENT_ACTION_PROVIDER=heuristic
INTENT_DOMAIN_CLASSIFIER=heuristic
INTENT_ENABLE_ANSWERS=true
INTENT_MAX_ANSWER_CHARS=800
INTENT_ACTIONS_ENABLED=repetitividad_report

# ─── Informes ─────────────────────────────────────────────────────────────────
TEMPLATES_DIR=/app/Templates
SLA_TEMPLATE_PATH=${TEMPLATES_DIR}/Template_Informe_SLA.docx
REP_TEMPLATE_PATH=${TEMPLATES_DIR}/Plantilla_Informe_Repetitividad.docx
REPORTS_DIR=/app/data/reports
UPLOADS_DIR=/app/data/uploads
SOFFICE_BIN=/usr/bin/soffice
MAPS_ENABLED=false
MAPS_LIGHTWEIGHT=true

# ─── Web/UI (DEV) ─────────────────────────────────────────────────────────────
# Puerto dev del frontend: 8090 (bind a loopback).
# Para acceso desde máquina remota: ssh -L 8090:localhost:8090 usuario@servidor
API_BASE=http://localhost:8090
WEB_INFERRED_ORIGIN=http://localhost:8090
WEB_SECRET_KEY=cambiar_por_clave_web_dev_segura
LOG_LEVEL=DEBUG
ENV=development
REPORTS_API_BASE=http://api:8000
REPORTS_API_TIMEOUT=60
LAS_FOCAS_API_KEY=cambiar_por_api_key_dev_segura
WEB_CHAT_ALLOWED_ORIGINS=
CHAT_UPLOAD_MAX_BYTES=15728640
WEB_LOGIN_RATE_LIMIT_MAX=5
WEB_LOGIN_RATE_LIMIT_WINDOW=60
WEB_SESSION_HTTPS_ONLY=false
WEB_SESSION_MAX_AGE=28800

# ─── Infraestructura (Sheets → DB) ────────────────────────────────────────────
INFRA_SHEET_ID=
INFRA_SHEET_NAME=Camaras
# Montar Keys/credentials.json dentro del contenedor o definir GOOGLE_CREDENTIALS_JSON
#GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# ─── Servicio LibreOffice/UNO ─────────────────────────────────────────────────
OFFICE_ENABLE_UNO=true
OFFICE_LOG_LEVEL=INFO
OFFICE_SOFFICE_PORT=2002
OFFICE_SOFFICE_CONNECT_HOST=127.0.0.1
OFFICE_SERVICE_BASE=http://office:8090

# ─── Notificaciones por correo (SMTP) ────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notificaciones@example.com
SMTP_PASS=cambiar_por_password_smtp_dev
SMTP_FROM_EMAIL=notificaciones@example.com
SMTP_FROM_NAME=LAS-FOCAS Dev Notificaciones
SMTP_USE_TLS=true

# ─── Slack (DEV) ──────────────────────────────────────────────────────────────
# IMPORTANTE: usar tokens de una Slack App de DESARROLLO separada de la de producción.
# Crear nueva app en https://api.slack.com/apps (ej: "LAS-FOCAS Dev").
# Dejar vacíos para arrancar sin el listener de ingresos técnicos.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ─── Cromo Red (DEV) ───────────────────────────────────────────────────────────
# Cromo no tiene ambiente de pruebas propio: es el mismo sistema de producción de
# Metrotel consultado sólo en modo lectura. Completar con las credenciales reales
# únicamente en .env.dev local, nunca commitear valores reales.
# Autenticación vía api-gateway: OAuth2 grant_type=password (ver manual oficial de Cromo Red,
# no versionado en el repo). CROMO_CLIENT_ID/CROMO_CLIENT_SECRET son credenciales de aplicación
# (OAUTH_CLIENT_DETAILS), distintas del usuario/password de Cromo.
CROMO_BASE_URL=http://cambiar-por-host-cromo:8181
CROMO_USER=cambiar_por_usuario_cromo
# CROMO_PASSWORD NO va acá: es un Docker Secret (cromo_password_v1), no una variable de
# entorno. Completar el archivo .secrets/Dev_cromo_password_v1.txt (crea uno vacío
# scripts/setup_local_secrets.sh; sin valor real, la ingesta Cromo falla con un
# CromoConfigError claro en vez de arrancar rota). Ver docs/infra.md, sección "Secretos dev
# adicionales".
CROMO_TIMEOUT=30
CROMO_PSIZE_DEFAULT=5
# Opcional: si no se define, se deriva de CROMO_BASE_URL en el puerto 9999.
CROMO_OAUTH_URL=
# Opcional: si no se definen, se usan los valores de fábrica del manual (a confirmar con el admin de Cromo).
CROMO_CLIENT_ID=
# CROMO_CLIENT_SECRET: mismo criterio que CROMO_PASSWORD si Metrotel llega a rotarlo — hoy
# no hay secreto cromo_client_secret_v1 provisionado porque no hizo falta (valor de fábrica).
