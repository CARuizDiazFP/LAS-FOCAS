# Nombre de archivo: .gitignore
# Ubicación de archivo: ./
# Descripción: Ignora archivos temporales, entornos locales, artefactos y secretos

# Entornos y secretos
.env
.env.*
.secrets/

!.env.sample
.envrc

# Claves locales
Keys/

# Entorno virtual Python
.venv*/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml

# Build/Dist
build/
dist/
wheelhouse/

# Logs y cache
*.log
logs/
Logs/
tmp/
temp_*.ini
temp_*.py
*.db
.cache/
.ipynb_checkpoints/

# Node/Front
node_modules/
web/frontend/node_modules/
web/frontend/dist/
web/static/assets/

# IDE/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker
docker-data/
.docker/

# Datos de informes
data/uploads/
data/reports/
Reports/
web/data/reports/
devs/

# Dumps y backups locales
*.dump
backup_*.dump

# Repositorios legacy
Legacy/

# Workspace de subagent-driven-development (ledgers, briefs, reportes por plan)
.superpowers/

# Documentación privada de la empresa (no debe subirse al repo)
docs/Doc Privada/
