#!/usr/bin/env bash
# Nombre de archivo: Start
# Ubicación de archivo: Start
# Descripción: Lanzador de PRODUCCIÓN (proyecto lasfocas): build, migraciones y up sin down global, con confirmación explícita. Desarrollo: scripts/start_dev.sh

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="$ROOT_DIR/deploy/compose.yml"
ENV_FILE="$ROOT_DIR/.env"
COMPOSE_BASE=(docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE")

HOST_IP="172.18.208.162" # Requerido según infraestructura de la VM
PROYECTO_PROD="lasfocas"
VOLUMEN_DB="lasfocas_postgres_data"
# El bot de Telegram está en el perfil por defecto pero no corre en prod: sólo con --with-bot.
EXCLUIDOS_POR_DEFECTO=(bot)
# Orden de la guía de despliegue: infraestructura y cromo_worker primero (un worker viejo trata
# tipos de corrida que no conoce como una ingesta COMPLETA), después el resto.
PRIMERA_TANDA=(postgres redis docker-socket-proxy cromo_worker)

YES_PROD=false
DRY_RUN=false
WITH_BOT=false
PURGE=false
REBUILD_FRONTEND=false
REBUILD_API=false
FORZAR_CROMO=false
NO_COLOR=false
PEDIDOS=()

usage() {
  cat <<EOF
Uso: ./Start [opciones]

Opera sobre PRODUCCIÓN: deploy/compose.yml (proyecto '$PROYECTO_PROD') con --env-file .env.
Para desarrollo usar ./scripts/start_dev.sh. El procedimiento completo de despliegue
(backup, ventana, rollback) está en docs/despliegue_produccion.md.

Qué hace: construye las imágenes, aplica las migraciones Alembic, levanta los servicios con
'up -d' (sólo recrea los que cambiaron; no hace 'down' del proyecto) y espera su healthcheck.
Por defecto levanta el perfil por defecto de compose.yml menos: ${EXCLUIDOS_POR_DEFECTO[*]}.

Opciones:
  --yes-prod            Confirma que se opera sobre producción (sin esto pide tipear '$PROYECTO_PROD')
  --dry-run             Muestra el plan y los comandos sin ejecutar nada
  --service <nombre>    Sólo ese servicio (repetible); también acepta servicios de perfiles (pgadmin)
  --with-bot            Incluye el bot de Telegram
  --rebuild-frontend    Rebuild sin cache de la imagen web
  --rebuild-api         Rebuild sin cache de la imagen api
  --forzar-cromo        Recrea cromo_worker aunque haya una corrida de ingesta EN_CURSO (la corta)
  --purge               PELIGRO: 'down -v' del proyecto entero; BORRA $VOLUMEN_DB.
                        Pide tipear el nombre del volumen aunque se pase --yes-prod
  --no-color            Deshabilita colores en salida
  -h, --help            Muestra esta ayuda

Ejemplos:
  ./Start --dry-run                       Ver qué se levantaría y con qué comandos
  ./Start                                 Build + migraciones + up (pide confirmación)
  ./Start --yes-prod --service web        Rebuild y recreación sólo del panel web
  ./Start --yes-prod --rebuild-frontend   Fuerza recompilación del frontend
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --yes-prod) YES_PROD=true ;;
    --dry-run) DRY_RUN=true ;;
    --service)
      [[ $# -ge 2 ]] || { echo -e "${RED}--service requiere un nombre${NC}"; exit 1; }
      PEDIDOS+=("$2"); shift ;;
    --with-bot) WITH_BOT=true ;;
    --rebuild-frontend) REBUILD_FRONTEND=true ;;
    --rebuild-api) REBUILD_API=true ;;
    --forzar-cromo) FORZAR_CROMO=true ;;
    --purge) PURGE=true ;;
    --no-down) echo -e "${YELLOW}--no-down es obsoleta: Start ya no hace 'down'. Se ignora.${NC}" ;;
    --no-color) NO_COLOR=true ;;
    -h|--help) usage; exit 0 ;;
    *) echo -e "${YELLOW}Opción desconocida: $1${NC}"; usage; exit 1 ;;
  esac
  shift
done

if $NO_COLOR; then GREEN=''; YELLOW=''; RED=''; NC=''; fi

# Ejecuta un comando, o lo imprime en --dry-run.
run() {
  if $DRY_RUN; then
    printf '  [dry-run]'; printf ' %q' "$@"; echo
  else
    "$@"
  fi
}

contiene() {
  local buscado="$1"; shift
  local item
  for item in "$@"; do [[ "$item" == "$buscado" ]] && return 0; done
  return 1
}

estado_contenedor() {
  local cid
  cid=$("${COMPOSE_BASE[@]}" ps -q "$1" 2>/dev/null | head -n1)
  [[ -n "$cid" ]] || { echo "ausente"; return 0; }
  docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || echo "ausente"
}

echo -e "${GREEN}=== LAS-FOCAS :: Start (PRODUCCIÓN) ===${NC}"

########################################
# 1) Verificaciones del host           #
########################################
command -v docker >/dev/null 2>&1 || { echo -e "${RED}Docker no está instalado en el PATH${NC}"; exit 1; }
if ! docker compose version >/dev/null 2>&1; then
  echo -e "${RED}No se encontró 'docker compose' plugin (v2).${NC}"; exit 1
fi
if [ ! -f "$ENV_FILE" ]; then
  # Copiar env.sample dejaría prod con credenciales de ejemplo: que lo arme una persona.
  echo -e "${RED}No existe $ENV_FILE. Crearlo desde deploy/env.sample y completar credenciales.${NC}"
  exit 1
fi

PROYECTO=$("${COMPOSE_BASE[@]}" config 2>/dev/null | awk '/^name:/ {print $2; exit}')
[[ -n "$PROYECTO" ]] || { echo -e "${RED}No se pudo leer el nombre del proyecto de $COMPOSE_FILE${NC}"; exit 1; }

########################################
# 2) Servicios a levantar               #
########################################
mapfile -t POR_DEFECTO < <("${COMPOSE_BASE[@]}" config --services 2>/dev/null)
mapfile -t TODOS < <("${COMPOSE_BASE[@]}" --profile '*' config --services 2>/dev/null)

SERVICES=()
if [[ ${#PEDIDOS[@]} -gt 0 ]]; then
  for s in "${PEDIDOS[@]}"; do
    contiene "$s" "${TODOS[@]}" || { echo -e "${RED}Servicio desconocido: $s${NC}"; exit 1; }
    SERVICES+=("$s")
  done
else
  $WITH_BOT && EXCLUIDOS_POR_DEFECTO=()
  for s in "${POR_DEFECTO[@]}"; do
    contiene "$s" "${EXCLUIDOS_POR_DEFECTO[@]}" || SERVICES+=("$s")
  done
fi

TANDA_1=(); TANDA_2=()
for s in "${SERVICES[@]}"; do
  if contiene "$s" "${PRIMERA_TANDA[@]}"; then TANDA_1+=("$s"); else TANDA_2+=("$s"); fi
done

echo "Proyecto:  $PROYECTO"
echo "Compose:   $COMPOSE_FILE"
echo "Env file:  $ENV_FILE"
echo "Servicios: ${SERVICES[*]}"
$PURGE && echo -e "${RED}PURGE: se ejecutará 'down -v' y se BORRARÁ $VOLUMEN_DB${NC}"
$DRY_RUN && echo -e "${YELLOW}Modo --dry-run: no se ejecuta nada.${NC}"

########################################
# 3) Confirmación                       #
########################################
confirmar_tipeando() {
  local esperado="$1" mensaje="$2" respuesta
  if [ ! -t 0 ]; then
    echo -e "${RED}$mensaje: hace falta una terminal interactiva para confirmar.${NC}"; exit 1
  fi
  read -r -p "$mensaje. Tipeá '$esperado' para continuar: " respuesta
  [[ "$respuesta" == "$esperado" ]] || { echo -e "${RED}Confirmación incorrecta. Abortado.${NC}"; exit 1; }
}

if ! $DRY_RUN; then
  if [[ "$PROYECTO" == "$PROYECTO_PROD" ]] && ! $YES_PROD; then
    confirmar_tipeando "$PROYECTO_PROD" "Vas a operar sobre PRODUCCIÓN ($PROYECTO_PROD)"
  fi
  if $PURGE; then
    confirmar_tipeando "$VOLUMEN_DB" "--purge BORRA la base de datos ($VOLUMEN_DB) sin vuelta atrás"
  fi
fi

########################################
# 4) Corrida de Cromo en curso          #
########################################
# Recrear cromo_worker corta la ingesta en curso (una SOLO_ODF tarda ~3,5 h).
if contiene cromo_worker "${SERVICES[@]}" && ! $FORZAR_CROMO; then
  if $DRY_RUN; then
    echo "  [dry-run] verificaría que no haya corridas EN_CURSO en app.cromo_ingesta_corridas"
  elif [[ "$(estado_contenedor postgres)" == "healthy" ]]; then
    consultar() {
      "${COMPOSE_BASE[@]}" exec -T postgres sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "$1"' _ "$1"
    }
    if [[ "$(consultar "select to_regclass('app.cromo_ingesta_corridas') is not null")" == "t" ]]; then
      EN_CURSO=$(consultar "select count(*) from app.cromo_ingesta_corridas where estado='EN_CURSO'") \
        || { echo -e "${RED}No se pudo consultar app.cromo_ingesta_corridas. Abortado (ver --forzar-cromo).${NC}"; exit 1; }
      if [[ "$EN_CURSO" != "0" ]]; then
        echo -e "${RED}Hay $EN_CURSO corrida(s) de Cromo EN_CURSO: recrear cromo_worker la cortaría.${NC}"
        echo "Esperar a que termine, excluir el servicio (--service ...) o usar --forzar-cromo."
        exit 1
      fi
    fi
  fi
fi

########################################
# 5) Purge (opcional)                   #
########################################
if $PURGE; then
  echo -e "${YELLOW}PURGE: down -v del proyecto y borrado de imágenes locales.${NC}"
  run "${COMPOSE_BASE[@]}" down -v --remove-orphans
  for s in "${SERVICES[@]}"; do
    img_id=$(docker images --format '{{.Repository}}:{{.Tag}} {{.ID}}' | awk '/lasfocas/ && /'"$s"'/ {print $2}' | head -n1)
    if [ -n "$img_id" ]; then run docker rmi "$img_id" || true; fi
  done
fi

########################################
# 6) Build                              #
########################################
echo -e "${GREEN}Verificando/construyendo imagen base focas-base...${NC}"
run "$ROOT_DIR/scripts/build_base.sh"
if $REBUILD_FRONTEND && contiene web "${SERVICES[@]}"; then
  run "${COMPOSE_BASE[@]}" build --no-cache web
fi
if $REBUILD_API && contiene api "${SERVICES[@]}"; then
  run "${COMPOSE_BASE[@]}" build --no-cache api
fi
echo -e "${GREEN}Construyendo imágenes: ${SERVICES[*]}${NC}"
run "${COMPOSE_BASE[@]}" build "${SERVICES[@]}"

########################################
# 7) Postgres + migraciones Alembic     #
########################################
# Las migraciones corren con la imagen nueva de api ANTES de recrear los servicios (mismo orden que
# docs/despliegue_produccion.md). La contraseña sale del secreto dentro del contenedor: no pasa por
# la línea de comandos del host.
echo -e "${GREEN}Asegurando Postgres...${NC}"
run "${COMPOSE_BASE[@]}" up -d postgres
if ! $DRY_RUN; then
  for i in $(seq 1 40); do
    estado=$(estado_contenedor postgres)
    [[ "$estado" == "healthy" ]] && { echo -e "${GREEN}Postgres healthy.${NC}"; break; }
    echo -e "${YELLOW}Esperando Postgres (estado: $estado) $i/40...${NC}"
    sleep 3
  done
  [[ "$(estado_contenedor postgres)" == "healthy" ]] || { echo -e "${RED}Postgres no quedó healthy.${NC}"; exit 2; }
fi

migrar() {
  "${COMPOSE_BASE[@]}" run --rm --no-deps -T api python - <<'PY'
import os
from urllib.parse import quote

from alembic.config import main

from core.config import get_secret

clave = quote(get_secret("db_password_v1", "POSTGRES_PASSWORD"), safe="")
os.environ.pop("DATABASE_URL", None)
os.environ["ALEMBIC_URL"] = (
    f"postgresql+psycopg://{os.getenv('POSTGRES_USER', 'lasfocas')}:{clave}"
    f"@{os.getenv('POSTGRES_HOST', 'postgres')}:{os.getenv('POSTGRES_PORT', '5432')}"
    f"/{os.getenv('POSTGRES_DB', 'lasfocas')}"
)
main(argv=["-c", "/app/db/alembic.ini", "upgrade", "head"])
PY
}

echo -e "${GREEN}Ejecutando migraciones Alembic...${NC}"
if $DRY_RUN; then
  echo "  [dry-run] ${COMPOSE_BASE[*]} run --rm --no-deps -T api python - (alembic upgrade head)"
else
  MIG_OK=false
  for i in $(seq 1 3); do
    if migrar; then MIG_OK=true; echo -e "${GREEN}Migraciones aplicadas.${NC}"; break; fi
    echo -e "${YELLOW}Intento de migración $i/3 fallido. Reintentando en 4s...${NC}"; sleep 4
  done
  $MIG_OK || { echo -e "${RED}No se pudieron aplicar las migraciones. No se recreó ningún servicio de aplicación.${NC}"; exit 2; }
fi

########################################
# 8) Up (sin down; recrea lo que cambió) #
########################################
if [[ ${#TANDA_1[@]} -gt 0 ]]; then
  echo -e "${GREEN}Levantando: ${TANDA_1[*]}${NC}"
  run "${COMPOSE_BASE[@]}" up -d "${TANDA_1[@]}"
fi
if [[ ${#TANDA_2[@]} -gt 0 ]]; then
  echo -e "${GREEN}Levantando: ${TANDA_2[*]}${NC}"
  run "${COMPOSE_BASE[@]}" up -d "${TANDA_2[@]}"
fi

if $DRY_RUN; then
  echo -e "${GREEN}Fin del dry-run.${NC}"; exit 0
fi

########################################
# 9) Health                             #
########################################
# healthy si el servicio declara healthcheck; running si no lo declara.
echo -e "${GREEN}Comprobando health de servicios...${NC}"
FALLIDOS=()
for s in "${SERVICES[@]}"; do
  estado="?"
  for i in $(seq 1 40); do
    estado=$(estado_contenedor "$s")
    [[ "$estado" == "healthy" || "$estado" == "running" ]] && break
    sleep 3
  done
  if [[ "$estado" == "healthy" || "$estado" == "running" ]]; then
    echo -e "  $s: ${GREEN}$estado${NC}"
  else
    echo -e "  $s: ${RED}$estado${NC}"; FALLIDOS+=("$s")
  fi
done

if [[ ${#FALLIDOS[@]} -gt 0 ]]; then
  echo -e "${RED}Servicios sin health OK: ${FALLIDOS[*]}. Revisar con:${NC}"
  echo "  docker compose -f deploy/compose.yml --env-file .env logs --tail=200 ${FALLIDOS[*]}"
  exit 2
fi

echo -e "${GREEN}Listo.${NC} UI: http://$HOST_IP:8080/  |  API: http://localhost:8001/docs"
